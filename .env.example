# Postgres (Neon), accessed through the WebSocket Pool driver (D-07): interactive
# transactions are required for set_config('app.restaurant_id') and SAVEPOINTs.
# Use the pooled URL for the app and the direct URL for migrations.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# Role with BYPASSRLS. Loaded only by the scheduled job and the Meta webhook (spec 01).
DATABASE_URL_SYSTEM=

# Dev auth bypass (S-25). Development only: the app refuses to start if this is set in production.
DEV_AUTH_BYPASS=

# Staff auth (Better Auth, implemented last per S-25; passwordless per S-27)
AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Email provider for magic links and sign-in codes is chosen in the "Real staff login" ticket.

# Public base URL, encoded into the table QR codes (spec 03)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Photo storage: Cloudflare R2 (spec 02, D-07)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Custom domain bound to the bucket. Never an r2.dev URL.
R2_PUBLIC_BASE_URL=

# WhatsApp Cloud API (spec 05)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Protects the scheduled job route (spec 05)
CRON_SECRET=

# Bot check on the booking confirm step (spec 04)
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
