# Validated with zod at startup by src/lib/env.ts. Keep the two in sync (a unit
# test checks). An empty value counts as unset.
#
# REQUIRED: DATABASE_URL, NEXT_PUBLIC_APP_URL and the five R2_* variables.
# REQUIRED IN PRODUCTION: DATABASE_URL_ADMIN, DATABASE_URL_STAFF_AUTH and the
# staff auth block below. That includes a local `npm run start`, so give it
# stand-ins there.
# Everything else is optional until the ticket that uses it makes it required.
# Exception: DATABASE_URL_SYSTEM and CRON_SECRET (the scheduled job, S-35) stay
# optional even though the job uses them, so a preview deployment without them
# still boots. The job's route refuses every call until both are set. So do
# WHATSAPP_PHONE_NUMBER_ID and WHATSAPP_ACCESS_TOKEN (S-37): without them the job
# holds WhatsApp messages instead of sending them.
#
# Local Postgres: `npm run db:up` starts Postgres 17 on localhost:5499 and a Neon
# wsproxy on localhost:5498. The values below marked "local" match it.

# Postgres (Neon), accessed through the WebSocket Pool driver (D-07): interactive
# transactions are required for set_config('app.restaurant_id') and SAVEPOINTs.
#
# The app connects as app_tenant (pooled URL), a role RLS applies to; the env
# schema refuses any other role here. Migrations create the role without a
# password, then `npm run db:migrate` gives it the password written in this URL.
# On Neon, don't create it in the Console: that would make it a neon_superuser.
# Passwords set over SQL on Neon need at least 60 bits of entropy.
# local: postgres://app_tenant:app_tenant@localhost:5499/restaurant_dev
DATABASE_URL=
# The role that owns the tables, on the direct URL. Used by `npm run db:migrate`
# and `npm run db:seed`, never by the app: RLS doesn't apply to it.
# local: postgres://app:app@localhost:5499/restaurant_dev
DATABASE_URL_UNPOOLED=
# The admin path's own login (S-28): the only role that can call the platform_*
# functions or touch the admin_auth_* tables. The env schema refuses any other
# role here, and only src/db/admin.ts opens it. Created by migration; `npm run
# db:migrate` gives it the password written here. Use a different password from
# DATABASE_URL: the point is that one can't be used as the other.
# local: postgres://app_admin:app_admin@localhost:5499/restaurant_dev
DATABASE_URL_ADMIN=
# Staff sign-in's own login (S-28, S-30): the only role that can touch the
# staff_auth_* tables, where a magic link is only a row, or look an email up
# across tenants (staff_identity_by_email). The env schema refuses any other role here, and only
# src/db/staff-auth.ts opens it. Created by migration; `npm run db:migrate` gives
# it the password written here. Use a password of its own, as for the admin.
# local: postgres://app_staff_auth:app_staff_auth@localhost:5499/restaurant_dev
DATABASE_URL_STAFF_AUTH=
# The scheduled job's own login, app_system (spec 01, S-28, S-35): BYPASSRLS,
# because the job works across every tenant, so it is granted only the columns
# the job touches (migration 0031). The env schema refuses any other role here,
# and only the job's route and the Meta webhook's open it (src/db/system.ts).
# Created by migration; `npm run db:migrate` needs it and gives
# it the password written here. Use a password of its own, as for the admin.
# local: postgres://app_system:app_system@localhost:5499/restaurant_dev
DATABASE_URL_SYSTEM=
# Local development and CI only: where the Neon wsproxy listens, as host:port/path.
# Turns off TLS to the database, so the app refuses to start with it in production.
# Leave unset against real Neon. local: localhost:5498/v1
NEON_WS_PROXY=
# Integration tests only (`npm run test:integration`); the tests migrate it.
# The owner role, for migrations and fixtures.
# local: postgres://app:app@localhost:5499/restaurant_test
TEST_DATABASE_URL=
# The same database as app_tenant. The tests prove tenant isolation through this.
# local: postgres://app_tenant:app_tenant@localhost:5499/restaurant_test
TEST_DATABASE_URL_APP=
# The same database as app_admin. The tests prove what only it can do through this.
# local: postgres://app_admin:app_admin@localhost:5499/restaurant_test
TEST_DATABASE_URL_ADMIN=
# The same database as app_staff_auth. The tests prove what only sign-in can do through this.
# local: postgres://app_staff_auth:app_staff_auth@localhost:5499/restaurant_test
TEST_DATABASE_URL_STAFF_AUTH=
# The same database as app_system. The tests run the scheduled job through this.
# local: postgres://app_system:app_system@localhost:5499/restaurant_test
TEST_DATABASE_URL_SYSTEM=

# Dev auth bypass (S-25). Any non-empty value turns it on, so `false` does too.
# Development only: the app refuses to start if this is set in production.
# local: 1
DEV_AUTH_BYPASS=

# Staff and platform-admin sign-in (Better Auth, passwordless per S-27).
# Signs the session cookies, so changing it signs everyone out. 32+ characters:
# `openssl rand -base64 32`. Needed to sign in locally without the bypass.
AUTH_SECRET=
# OAuth client from Google Cloud. Authorized redirect URIs, one per session type:
# {NEXT_PUBLIC_APP_URL}/api/auth/staff/callback/google and .../admin/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Sends magic links and sign-in codes (D-09, proposed: Resend). Leave blank in
# development and the emails are printed to the server console instead.
RESEND_API_KEY=
# On a domain verified with the provider, e.g. Sign-in <sign-in@example.com>
EMAIL_FROM=

# Public base URL, encoded into the table QR codes (spec 03)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Photo storage: Cloudflare R2 (spec 02, D-07)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Custom domain bound to the bucket, https. Never an r2.dev URL.
R2_PUBLIC_BASE_URL=

# WhatsApp Cloud API (spec 05, S-37). The sender's two keys stay optional even in
# production, like DATABASE_URL_SYSTEM: with both unset, production holds queued
# messages as pending and sends them once both are set, and development prints
# each message to the console. One without the other holds everywhere.
# The phone number's ID from WhatsApp Manager: digits, not the phone number.
WHATSAPP_PHONE_NUMBER_ID=
# A permanent system-user token, alone: no "Bearer".
WHATSAPP_ACCESS_TOKEN=
# Meta's webhook, POST/GET /api/webhooks/whatsapp (#48). The app secret (Meta app
# dashboard, App settings > Basic) checks the signature on every delivery status;
# unset, the webhook refuses them all. The verify token is any random string you
# also type into Meta's webhook setup; unset, Meta can't subscribe.
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Protects the scheduled job's route, GET /api/cron/tick (S-35). Vercel Cron sends
# it as `Authorization: Bearer <CRON_SECRET>`. At least 32 characters, or the
# route refuses every call: e.g. `openssl rand -hex 32`. In development, call the
# route yourself with that header; nothing schedules it locally.
CRON_SECRET=

# Bot check on the booking confirm step (spec 04)
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
